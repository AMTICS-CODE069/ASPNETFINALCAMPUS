@model ComplaintFormViewModel
@{
    ViewData["Title"] = "Edit Complaint";
}
<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card cf-card shadow-sm">
            <div class="card-body p-4">
                <h3 class="mb-3"><i class="bi bi-pencil-square"></i> Edit complaint #@Model.Id</h3>
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate>
                    <partial name="_ComplaintForm" model="Model" />
                    <button class="btn btn-primary" type="submit">Save changes</button>
                    <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
