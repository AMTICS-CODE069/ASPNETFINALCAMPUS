@model LoginViewModel
@{
    ViewData["Title"] = "Login";
}
<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card cf-card shadow-sm">
            <div class="card-body p-4">
                <h3 class="mb-3"><i class="bi bi-box-arrow-in-right"></i> Login</h3>
                <form asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" autofocus />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <button class="btn btn-primary w-100" type="submit">Login</button>
                </form>
                <p class="mt-3 mb-0 small text-center">New here? <a asp-action="Register">Create an account</a></p>
            </div>
        </div>
        <div class="alert alert-secondary mt-3 small">
            <strong>Demo accounts</strong><br />
            Admin: admin@@campusfix.com / Admin@123<br />
            Student: student@@campusfix.com / Student@123
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
