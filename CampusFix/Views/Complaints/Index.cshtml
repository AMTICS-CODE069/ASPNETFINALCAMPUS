@model ComplaintListViewModel
@{
    ViewData["Title"] = Model.IsAdmin ? "All Complaints" : "My Complaints";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h2 class="mb-0">@ViewData["Title"] <span class="badge bg-secondary fs-6">@Model.TotalCount</span></h2>
    @if (!Model.IsAdmin)
    {
        <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-circle"></i> New Complaint</a>
    }
</div>

<form method="get" class="card cf-card p-3 mb-4">
    <div class="row g-2">
        <div class="col-md-4">
            <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Search title or location..." />
        </div>
        <div class="col-md-3">
            <select name="status" class="form-select">
                <option value="">All statuses</option>
                @foreach (var s in Enum.GetValues<ComplaintStatus>())
                {
                    <option value="@((int)s)" selected="@(Model.Status == s)">@UiHelper.StatusText(s)</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <select name="category" class="form-select">
                <option value="">All categories</option>
                @foreach (var c in Enum.GetValues<ComplaintCategory>())
                {
                    <option value="@((int)c)" selected="@(Model.Category == c)">@UiHelper.CategoryText(c)</option>
                }
            </select>
        </div>
        <div class="col-md-2 d-grid d-md-flex gap-2">
            <button class="btn btn-primary flex-fill" type="submit"><i class="bi bi-search"></i></button>
            <a class="btn btn-outline-secondary flex-fill" asp-action="Index">Reset</a>
        </div>
    </div>
</form>

@if (!Model.Items.Any())
{
    <div class="text-center text-body-secondary py-5">
        <div class="display-3"><i class="bi bi-inbox"></i></div>
        <p class="mb-0">No complaints found.</p>
    </div>
}
else
{
    <div class="card cf-card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Complaint</th>
                        <th>Category</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>Date</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var c in Model.Items)
                {
                    <tr>
                        <td>@c.Id</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@c.Id" class="fw-semibold text-decoration-none">@c.Title</a>
                            <div class="small text-body-secondary">
                                <i class="bi bi-geo-alt"></i> @c.Location
                                @if (Model.IsAdmin) { <span> &middot; <i class="bi bi-person"></i> @c.User?.FullName</span> }
                            </div>
                        </td>
                        <td><i class="bi @UiHelper.CategoryIcon(c.Category)"></i> @UiHelper.CategoryText(c.Category)</td>
                        <td><span class="badge @UiHelper.PriorityClass(c.Priority)">@c.Priority</span></td>
                        <td><span class="badge @UiHelper.StatusClass(c.Status)">@UiHelper.StatusText(c.Status)</span></td>
                        <td class="small">@c.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@c.Id" title="View"><i class="bi bi-eye"></i></a>
                            @if (!Model.IsAdmin && c.Status == ComplaintStatus.Pending)
                            {
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@c.Id" title="Edit"><i class="bi bi-pencil"></i></a>
                            }
                            @if (Model.IsAdmin || c.Status == ComplaintStatus.Pending)
                            {
                                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@c.Id" title="Delete"><i class="bi bi-trash"></i></a>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                @for (var p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p"
                           asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-category="@Model.Category">@p</a>
                    </li>
                }
            </ul>
        </nav>
    }
}
