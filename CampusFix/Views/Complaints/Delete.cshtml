@model Complaint
@{
    ViewData["Title"] = "Delete Complaint";
}
<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card cf-card border-danger shadow-sm">
            <div class="card-body p-4">
                <h3 class="text-danger"><i class="bi bi-exclamation-triangle"></i> Delete this complaint?</h3>
                <p class="text-body-secondary">This will permanently remove the complaint and all its comments.</p>
                <dl class="row mb-4">
                    <dt class="col-sm-3">Title</dt><dd class="col-sm-9">@Model.Title</dd>
                    <dt class="col-sm-3">Category</dt><dd class="col-sm-9">@UiHelper.CategoryText(Model.Category)</dd>
                    <dt class="col-sm-3">Status</dt><dd class="col-sm-9"><span class="badge @UiHelper.StatusClass(Model.Status)">@UiHelper.StatusText(Model.Status)</span></dd>
                    <dt class="col-sm-3">Raised by</dt><dd class="col-sm-9">@Model.User?.FullName</dd>
                </dl>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                    <button class="btn btn-danger" type="submit">Yes, delete</button>
                    <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>
