@model Complaint
@{
    ViewData["Title"] = "Complaint #" + Model.Id;
    var isAdmin = Context.Session.GetString("Role") == "Admin";
    var userId = Context.Session.GetInt32("UserId");
    var isOwner = Model.UserId == userId;
}

<a asp-action="Index" class="text-decoration-none"><i class="bi bi-arrow-left"></i> Back to list</a>

<div class="row g-4 mt-1">
    <div class="col-lg-7">
        <div class="card cf-card shadow-sm">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                    <h3 class="mb-0">@Model.Title</h3>
                    <span class="badge fs-6 @UiHelper.StatusClass(Model.Status)">@UiHelper.StatusText(Model.Status)</span>
                </div>
                <div class="mt-2 mb-3">
                    <span class="badge @UiHelper.PriorityClass(Model.Priority)">@Model.Priority priority</span>
                    <span class="badge bg-secondary"><i class="bi @UiHelper.CategoryIcon(Model.Category)"></i> @UiHelper.CategoryText(Model.Category)</span>
                </div>
                <p style="white-space:pre-wrap">@Model.Description</p>
                <hr />
                <div class="row small text-body-secondary">
                    <div class="col-sm-6"><i class="bi bi-geo-alt"></i> @Model.Location</div>
                    <div class="col-sm-6"><i class="bi bi-person"></i> @Model.User?.FullName @(Model.User?.EnrollmentNo != null ? "(" + Model.User.EnrollmentNo + ")" : "")</div>
                    <div class="col-sm-6"><i class="bi bi-calendar"></i> Raised: @Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</div>
                    @if (Model.UpdatedAt != null)
                    {
                        <div class="col-sm-6"><i class="bi bi-clock-history"></i> Updated: @Model.UpdatedAt.Value.ToString("dd MMM yyyy, hh:mm tt")</div>
                    }
                </div>

                <div class="mt-4">
                    @if (isOwner && Model.Status == ComplaintStatus.Pending)
                    {
                        <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id"><i class="bi bi-pencil"></i> Edit</a>
                    }
                    @if (isAdmin || (isOwner && Model.Status == ComplaintStatus.Pending))
                    {
                        <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.Id"><i class="bi bi-trash"></i> Delete</a>
                    }
                </div>
            </div>
        </div>

        @if (isAdmin)
        {
            <div class="card cf-card shadow-sm mt-4">
                <div class="card-body">
                    <h5><i class="bi bi-gear"></i> Update status</h5>
                    <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post" class="row g-2">
                        <div class="col-md-4">
                            <select name="status" class="form-select">
                                @foreach (var s in Enum.GetValues<ComplaintStatus>())
                                {
                                    <option value="@((int)s)" selected="@(Model.Status == s)">@UiHelper.StatusText(s)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <input type="text" name="remark" maxlength="400" class="form-control" placeholder="Remark for the student (optional)" />
                        </div>
                        <div class="col-md-2 d-grid">
                            <button class="btn btn-primary" type="submit">Update</button>
                        </div>
                    </form>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-5">
        <div class="card cf-card shadow-sm">
            <div class="card-body">
                <h5><i class="bi bi-chat-dots"></i> Activity &amp; comments</h5>
                @if (!Model.Comments.Any())
                {
                    <p class="text-body-secondary small">No activity yet.</p>
                }
                @foreach (var cm in Model.Comments.OrderBy(x => x.CreatedAt))
                {
                    <div class="cf-comment @(cm.User?.Role == "Admin" ? "cf-comment-admin" : "")">
                        <div class="small fw-semibold">
                            @cm.User?.FullName
                            @if (cm.User?.Role == "Admin") { <span class="badge bg-warning text-dark">Admin</span> }
                            <span class="text-body-secondary fw-normal">&middot; @cm.CreatedAt.ToString("dd MMM, hh:mm tt")</span>
                        </div>
                        <div>@cm.Text</div>
                    </div>
                }
                <form asp-action="AddComment" asp-route-id="@Model.Id" method="post" class="mt-3">
                    <textarea name="text" class="form-control mb-2" rows="2" maxlength="500" placeholder="Write a comment..." required></textarea>
                    <button class="btn btn-sm btn-primary" type="submit"><i class="bi bi-send"></i> Post</button>
                </form>
            </div>
        </div>
    </div>
</div>
